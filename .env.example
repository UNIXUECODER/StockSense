# StockSense Environment Configuration Example
# Copy this file to .env to set your local credentials

# Flask Port & Environment
FLASK_ENV=development
PORT=5000

# Optional: Financial News API (https://newsapi.org/)
NEWS_API_KEY=

# Optional: Alpha Vantage API for extended fundamentals (https://www.alphavantage.co/)
ALPHA_VANTAGE_KEY=
